FROM python:slim-bookworm@sha256:980c03657c7c8bfbce5212d242ffe5caf69bfd8b6c8383e3580b27d028a6ddb3

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /opt/dagster/app

# Copy manifests first for layer caching
COPY pyproject.toml uv.lock ./
COPY src/ ./src/

# Install project + deps; put venv on PATH so dagster is available
RUN uv sync --frozen
ENV PATH="/opt/dagster/app/.venv/bin:$PATH"

EXPOSE 4000

# CMD allows this to be overridden from run launchers or executors to execute runs and steps
CMD ["dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "4000", "-f", "src/datascience_as_a_service/definitions.py"]
