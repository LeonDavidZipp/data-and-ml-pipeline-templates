# MLflow
MLFLOW_URL="http://mlflow:5001"
MLFLOW_PORT=5001
MLFLOW_S3_ENDPOINT_URL="http://minio:9000"
MLFLOW_S3_IGNORE_TLS="true"
MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://mlflow/"
MLFLOW_ARTIFACTS_DESTINATION="s3://mlflow/"

# PostgreSQL
POSTGRES_USER="dp_pg_user"
POSTGRES_PASSWORD="supersecret"
POSTGRES_DB="dp_db"

# S3 / AWS (used by Dagster S3Resource and MLflow — points at MinIO)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=8900
AWS_ENDPOINT_URL="http://minio:9000"
AWS_ACCESS_KEY_ID="dp_minio_user"
AWS_SECRET_ACCESS_KEY="supersecret"
AWS_REGION="us-east-1"

# HTTP
HTTP_API_TOKEN=""