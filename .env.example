# MLflow
MLFLOW_URL="http://mlflow:5001"
MLFLOW_PORT=5001
MLFLOW_S3_ENDPOINT_URL="http://rustfs:9000"
MLFLOW_S3_IGNORE_TLS="true"
MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://mlflow/"
MLFLOW_ARTIFACTS_DESTINATION="s3://mlflow/"

# PostgreSQL MLFlow
MLFLOW_POSTGRES_USER="mlflow_pg_user"
MLFLOW_POSTGRES_PASSWORD="supersecret"
MLFLOW_POSTGRES_DB="mlflow_db"

# PostgreSQL Dagster
DAGSTER_POSTGRES_USER="dagster_pg_user"
DAGSTER_POSTGRES_PASSWORD="supersecret"
DAGSTER_POSTGRES_DB="dagster_db"

# S3 / AWS (used by Dagster S3Resource and MLflow — points at RustFS)
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
AWS_ENDPOINT_URL="http://rustfs:9000"
AWS_ACCESS_KEY_ID="dp_rustfs_user"
AWS_SECRET_ACCESS_KEY="supersecret"
AWS_REGION="us-east-1"
# RustFS/MinIO serve plain HTTP; set to "false" once endpoint_url is HTTPS (real AWS S3)
AWS_ALLOW_HTTP="true"

# HTTP
HTTP_API_TOKEN=""

# SQL ingestion source (dialect-agnostic — scheme picks the dialect,
# e.g. postgresql://, mysql://, mssql://)
SQL_SOURCE_CONNECTION_URI=""

# Alerting — webhook posted to on run failure (Slack/Mattermost-compatible
# {"text": ...} payload). Leave empty to disable.
ALERT_WEBHOOK_URL=""